# Use with an explicit project name so the green volume can never alias blue:
# docker compose -p migratorybird-green -f compose.green.yaml up -d
STYLE_ROTATION_DATABASE_URL=postgresql+psycopg://style_rotation:style_rotation@127.0.0.1:55433/style_rotation_green

# Keep large runtime payloads outside the OneDrive workspace. Choose a local
# non-synchronised directory before starting workers.
STYLE_ROTATION_V022_PAYLOAD_DIRECTORY=C:/path/outside/OneDrive/MigratoryBird/green_v022_payloads
