{
  "catalog_type": "signal",
  "catalog_version": "0.2.0",
  "key_rule": "{template_key}__{factor_variant_key}",
  "defaults": {
    "missing_policy": "error_after_common_warmup",
    "tie_policy": "average_rank",
    "continuous_normalization": "cross_sectional_centered_rank_-1_1"
  },
  "templates": [
    {
      "key": "return_continuation",
      "factor_variants": ["total_return__w5", "total_return__w20", "total_return__w60", "total_return__w120", "total_return__w252"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "momentum",
      "dimension_hint": "momentum_trend",
      "rationale_type": "academic",
      "rationale": "Relative return strength may persist because information and capital adjust gradually.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "short_return_reversal",
      "factor_variants": ["total_return__w5", "total_return__w20"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "reversal",
      "dimension_hint": "reversal",
      "rationale_type": "academic",
      "rationale": "Very recent relative underperformance may reverse after temporary price pressure or overreaction.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "lagged_return_continuation",
      "factor_variants": ["lagged_return__l120_s20", "lagged_return__l252_s20"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "momentum",
      "dimension_hint": "momentum_trend",
      "rationale_type": "academic",
      "rationale": "Skipping the most recent month separates medium-term continuation from short-term reversal.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "ma_trend_strength",
      "factor_variants": ["moving_average_ratio__s20_l60", "moving_average_ratio__s60_l120", "moving_average_ratio__s1_l50", "moving_average_ratio__s1_l200", "moving_average_ratio__s50_l200"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A higher short-to-long moving-average ratio represents stronger prevailing trend.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "price_above_ma_state",
      "factor_variants": ["moving_average_ratio__s1_l50", "moving_average_ratio__s1_l200"],
      "form": "threshold_state",
      "direction": "higher_is_better",
      "rule": {"operator": ">", "threshold": 0, "true_score": 1, "false_score": -1},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "Price above a widely followed moving average marks a positive trend state.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "price_cross_above_ma",
      "factor_variants": ["moving_average_ratio__s1_l50", "moving_average_ratio__s1_l200"],
      "form": "crossover_event",
      "direction": "higher_is_better",
      "rule": {"previous": "<=0", "current": ">0", "event_score": 1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A fresh upward price/average crossing can mark trend initiation.",
      "research_tier": "exploratory",
      "product_eligible": false
    },
    {
      "key": "price_cross_below_ma",
      "factor_variants": ["moving_average_ratio__s1_l50", "moving_average_ratio__s1_l200"],
      "form": "crossover_event",
      "direction": "lower_is_better",
      "rule": {"previous": ">=0", "current": "<0", "event_score": -1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A fresh downward price/average crossing can mark trend deterioration.",
      "research_tier": "exploratory",
      "product_eligible": false
    },
    {
      "key": "golden_cross_event",
      "factor_variants": ["moving_average_ratio__s50_l200"],
      "form": "crossover_event",
      "direction": "higher_is_better",
      "rule": {"previous": "<=0", "current": ">0", "event_score": 1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "The 50-day average crossing above the 200-day average is a classic long-horizon trend event.",
      "research_tier": "exploratory",
      "product_eligible": false
    },
    {
      "key": "death_cross_event",
      "factor_variants": ["moving_average_ratio__s50_l200"],
      "form": "crossover_event",
      "direction": "lower_is_better",
      "rule": {"previous": ">=0", "current": "<0", "event_score": -1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "The 50-day average crossing below the 200-day average is a classic long-horizon deterioration event.",
      "research_tier": "exploratory",
      "product_eligible": false
    },
    {
      "key": "rsi_relative_strength",
      "factor_variants": ["rsi__w14"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "momentum",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "Persistently high RSI can represent relative leadership rather than immediate reversal.",
      "research_tier": "sensitivity",
      "product_eligible": true
    },
    {
      "key": "rsi_mean_reversion",
      "factor_variants": ["rsi__w14"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "reversal",
      "dimension_hint": "reversal",
      "rationale_type": "market_convention",
      "rationale": "Lower RSI represents greater relative oversold pressure and a possible rebound.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "rsi_oversold_state",
      "factor_variants": ["rsi__w14"],
      "form": "threshold_state",
      "direction": "lower_is_better",
      "rule": {"operator": "<=", "threshold": 30, "true_score": 1, "false_score": 0},
      "economic_family": "reversal",
      "dimension_hint": "reversal",
      "rationale_type": "market_convention",
      "rationale": "RSI at or below 30 is a conventional oversold state.",
      "research_tier": "canonical",
      "product_eligible": false
    },
    {
      "key": "rsi_overbought_state",
      "factor_variants": ["rsi__w14"],
      "form": "threshold_state",
      "direction": "higher_is_better",
      "rule": {"operator": ">=", "threshold": 70, "true_score": -1, "false_score": 0},
      "economic_family": "reversal",
      "dimension_hint": "reversal",
      "rationale_type": "market_convention",
      "rationale": "RSI at or above 70 is a conventional overbought state and bearish reversal warning.",
      "research_tier": "canonical",
      "product_eligible": false
    },
    {
      "key": "low_skew_premium",
      "factor_variants": ["return_skewness__w60", "return_skewness__w120"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "tail_premium",
      "dimension_hint": "tail_distribution",
      "rationale_type": "academic",
      "rationale": "Assets with lottery-like positive skew may be over-demanded, leaving relatively low-skew assets with a premium.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "high_skew_regime",
      "factor_variants": ["return_skewness__w60", "return_skewness__w120"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "tail_regime",
      "dimension_hint": "tail_distribution",
      "rationale_type": "practitioner_hypothesis",
      "rationale": "Positive return asymmetry may identify upside-led risk-on leadership in a relative rotation context.",
      "research_tier": "exploratory",
      "product_eligible": true
    },
    {
      "key": "low_kurtosis_quality",
      "factor_variants": ["return_excess_kurtosis__w120", "return_excess_kurtosis__w252"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "tail_risk",
      "dimension_hint": "tail_distribution",
      "rationale_type": "institutional_research",
      "rationale": "Lower excess kurtosis represents fewer extreme-return observations and a more stable return distribution.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "high_kurtosis_tail_regime",
      "factor_variants": ["return_excess_kurtosis__w120", "return_excess_kurtosis__w252"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "tail_regime",
      "dimension_hint": "tail_distribution",
      "rationale_type": "practitioner_hypothesis",
      "rationale": "Concentrated extreme returns may identify an active regime shift whose relative direction can persist.",
      "research_tier": "exploratory",
      "product_eligible": true
    },
    {
      "key": "low_volatility",
      "factor_variants": ["realized_volatility__w20", "realized_volatility__w60"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "low_risk",
      "dimension_hint": "volatility_risk",
      "rationale_type": "academic",
      "rationale": "Lower realized volatility can represent more efficient risk-adjusted exposure and the low-volatility effect.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "low_downside_risk",
      "factor_variants": ["downside_deviation__w20", "downside_deviation__w60"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "downside_risk",
      "dimension_hint": "volatility_risk",
      "rationale_type": "institutional_research",
      "rationale": "Lower downside deviation favors assets with less harmful return variability.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "drawdown_resilience",
      "factor_variants": ["maximum_drawdown__w60", "maximum_drawdown__w120"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "drawdown_risk",
      "dimension_hint": "volatility_risk",
      "rationale_type": "institutional_research",
      "rationale": "A shallower recent drawdown indicates stronger capital preservation and trend resilience.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "deep_drawdown_reversal",
      "factor_variants": ["maximum_drawdown__w60", "maximum_drawdown__w120"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "reversal",
      "dimension_hint": "reversal",
      "rationale_type": "practitioner_hypothesis",
      "rationale": "A deeper relative drawdown can create rebound potential after forced selling or overreaction.",
      "research_tier": "exploratory",
      "product_eligible": true
    },
    {
      "key": "dollar_volume_attention",
      "factor_variants": ["relative_dollar_volume__w20", "relative_dollar_volume__w60"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "attention_liquidity",
      "dimension_hint": "volume_liquidity",
      "rationale_type": "institutional_research",
      "rationale": "Elevated dollar volume can reflect stronger attention, participation and executable trend confirmation.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "low_illiquidity_quality",
      "factor_variants": ["amihud_illiquidity__w20", "amihud_illiquidity__w60"],
      "form": "continuous",
      "direction": "lower_is_better",
      "economic_family": "liquidity_quality",
      "dimension_hint": "volume_liquidity",
      "rationale_type": "institutional_research",
      "rationale": "Lower price impact per dollar traded represents better liquidity and implementation quality.",
      "research_tier": "canonical",
      "product_eligible": true
    },
    {
      "key": "illiquidity_premium",
      "factor_variants": ["amihud_illiquidity__w20", "amihud_illiquidity__w60"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "liquidity_premium",
      "dimension_hint": "volume_liquidity",
      "rationale_type": "academic",
      "rationale": "Investors may require compensation for bearing relatively greater illiquidity.",
      "research_tier": "exploratory",
      "product_eligible": true
    },
    {
      "key": "ppo_trend_acceleration",
      "factor_variants": ["ppo_histogram__f12_s26_g9"],
      "form": "continuous",
      "direction": "higher_is_better",
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A higher PPO histogram indicates positive normalized trend acceleration.",
      "research_tier": "exploratory",
      "product_eligible": true
    },
    {
      "key": "ppo_cross_above_zero",
      "factor_variants": ["ppo_histogram__f12_s26_g9"],
      "form": "crossover_event",
      "direction": "higher_is_better",
      "rule": {"previous": "<=0", "current": ">0", "event_score": 1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A histogram crossing above zero marks improving normalized trend acceleration.",
      "research_tier": "exploratory",
      "product_eligible": false
    },
    {
      "key": "ppo_cross_below_zero",
      "factor_variants": ["ppo_histogram__f12_s26_g9"],
      "form": "crossover_event",
      "direction": "lower_is_better",
      "rule": {"previous": ">=0", "current": "<0", "event_score": -1, "otherwise": "neutral"},
      "economic_family": "trend",
      "dimension_hint": "momentum_trend",
      "rationale_type": "market_convention",
      "rationale": "A histogram crossing below zero marks deteriorating normalized trend acceleration.",
      "research_tier": "exploratory",
      "product_eligible": false
    }
  ]
}
